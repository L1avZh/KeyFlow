<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: KeyFlow is local-first with no server,
         sync, or telemetry (see PRIVACY.md). Every permission below is
         requested only because a specific feature genuinely cannot work
         without it; if a feature can work without a permission, it does
         not request one. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".KeyFlowApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.KeyFlow"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true">

        <!--
          android:allowBackup="false" + dataExtractionRules deliberately
          exclude everything: an OS-level backup (Auto Backup / device
          transfer) is a copy of the encrypted vault file that could end
          up in Google Drive or a new-device transfer outside KeyFlow's
          own security model. The vault file itself is still AES-256-GCM
          encrypted even if a backup mechanism did copy it, but the
          simplest, least-surprising rule is: nothing about a locked
          vault leaves this device via any channel KeyFlow didn't
          explicitly build (there is no sync feature — see ROADMAP.md).
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KeyFlow.Splash"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!--
              android:excludeFromRecents is intentionally NOT set — Android
              already redacts app previews in the recent-apps switcher via
              FLAG_SECURE, applied in MainActivity.onCreate rather than
              here, so recents shows the app icon/name but never a
              screenshot of vault contents.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Transparent, no-history activity the Autofill Service launches
          (via a PendingIntent, never called directly by another app) to
          require unlock/biometric auth before a dataset is filled. Not
          exported: only KeyFlow's own PendingIntent can start it, so a
          malicious app cannot invoke it directly to fish for a UI state.
        -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.KeyFlow.Transparent"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true" />

        <service
            android:name=".autofill.KeyFlowAutofillService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
